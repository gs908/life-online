# server/.env.example
# 环境变量模板。复制为 .env 并填入实际值。
# 真实 .env 不要提交到 git。

# === App ===
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# === Database (PostgreSQL / Supabase) ===
# 独立字段,运行时由 config.py 拼接为 postgresql+asyncpg / postgresql+psycopg URL
# 当前推荐使用 Supabase pooler 连接方式。
# 字符集无需配置:PG 编码是库级属性(本库 UTF8),client_encoding 自动协商;
# 不要按 MySQL 习惯加 charset= 参数(驱动不认识,详见 README §4.3)。
DATABASE_DIALECT=postgresql
DATABASE_ASYNC_DRIVER=asyncpg
DATABASE_SYNC_DRIVER=psycopg
DATABASE_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DATABASE_PORT=6543
DATABASE_USER=postgres.mjonchwjzealatkbtbgd
DATABASE_PASSWORD=your-database-password
DATABASE_NAME=postgres
DATABASE_SSLMODE=require
DATABASE_APPLICATION_NAME=life-online

# === Storage ===
# 可选: minio / local。local 也兼容 filestorage / file。
STORAGE_PROVIDER=minio

# === Storage: MinIO ===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=life-online

# === Storage: Local FileStorage ===
LOCAL_STORAGE_ROOT=./uploads
LOCAL_STORAGE_PUBLIC_BASE_URL=/api/v1/files
LOCAL_STORAGE_BUCKET=local

# === AI 能力(按能力分组,对应 config.yaml 的 ai: 段) ===
# 各能力独立指定 provider / 模型;key 一律走环境变量,yaml 不落明文。
# enabled 与默认参数(temperature/size/duration 等)在 config.yaml 的
# ai.<能力>.default_params 收敛,请求级可覆盖。
# 未启用(enabled=false)或未配置时,对应 AI 接口返回 503。

# --- AI: LLM(文本/JSON,OpenAI 协议) ---
# 默认指向火山引擎 Ark Coding + Kimi K2.6
# 也可改为 OpenAI / DeepSeek / 通义千问 / Ollama 等任何 OpenAI 兼容端点
AI_LLM_PROVIDER=openai-compatible
AI_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
AI_LLM_API_KEY=your-api-key-here
AI_LLM_MODEL=kimi-k2.6

# --- AI: 图片生成(本期默认关闭;启用需在 config.yaml 置 ai.image.enabled=true) ---
AI_IMAGE_PROVIDER=openai-compatible
AI_IMAGE_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=

# --- AI: 视频生成(本期默认关闭;启用需在 config.yaml 置 ai.video.enabled=true) ---
AI_VIDEO_PROVIDER=openai-compatible
AI_VIDEO_BASE_URL=
AI_VIDEO_API_KEY=
AI_VIDEO_MODEL=

# === JWT ===
JWT_SECRET=please-replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=14

# === WeChat Open Platform (网站扫码登录) ===
WECHAT_OPEN_APPID=
WECHAT_OPEN_SECRET=
WECHAT_OPEN_REDIRECT_URI=http://localhost:8000/api/v1/auth/wechat/callback

# === WeChat Mini Program ===
WECHAT_MP_APPID=
WECHAT_MP_SECRET=

# === Redis (预留) ===
# 已接入 config.yaml(redis.enabled / redis.url),当前功能上暂无消费者
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
