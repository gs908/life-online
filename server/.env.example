# server/.env.example
# 环境变量模板。复制为 .env 并填入实际值。
# 真实 .env 不要提交到 git。

# === App ===
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# === Database (MySQL) ===
# 独立字段,运行时由 config.py 拼接为 mysql+asyncmy://... URL
DATABASE_HOST=127.0.0.1
DATABASE_PORT=4400
DATABASE_USER=dev
DATABASE_PASSWORD=
DATABASE_NAME=salers
DATABASE_CHARSET=utf8mb4

# === Storage ===
# 可选: minio / local。local 也兼容 filestorage / file。
STORAGE_PROVIDER=minio

# === Storage: MinIO ===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=life-online

# === Storage: Local FileStorage ===
LOCAL_STORAGE_ROOT=./uploads
LOCAL_STORAGE_PUBLIC_BASE_URL=/api/v1/files
LOCAL_STORAGE_BUCKET=local

# === LLM (OpenAI 协议) ===
# 默认指向火山引擎 Ark Coding + Kimi K2.6
# 也可改为 OpenAI / DeepSeek / 通义千问 / Ollama 等任何 OpenAI 兼容端点
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
LLM_API_KEY=your-api-key-here
LLM_MODEL=kimi-k2.6

# === JWT ===
JWT_SECRET=please-replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=14

# === WeChat Open Platform (网站扫码登录) ===
WECHAT_OPEN_APPID=
WECHAT_OPEN_SECRET=
WECHAT_OPEN_REDIRECT_URI=http://localhost:8000/api/v1/auth/wechat/callback

# === WeChat Mini Program ===
WECHAT_MP_APPID=
WECHAT_MP_SECRET=

# === Redis (预留) ===
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
